{
  "manifest_version": 3,
  "name": "Amper",
  "short_name": "Amper",
  "version": "0.1.2",
  "description": "Chemistry autocorrect for Google Docs. Opt in; processing stays on your device.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "action": { "default_title": "Amper", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
